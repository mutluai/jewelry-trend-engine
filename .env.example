# ============================================================
# Jewelry Trend Engine — Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to git.
# ============================================================

# ------------------------------------------------------------
# SUPABASE
# Get from: https://app.supabase.com/project/<id>/settings/api
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct PostgreSQL connection string
# Get from: Supabase > Settings > Database > Connection String (URI)
# Use the "Session mode" connection string for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# Supabase Storage bucket name (create this in Supabase Storage)
SUPABASE_STORAGE_BUCKET=reports

# ------------------------------------------------------------
# UPSTASH REDIS
# Get from: https://console.upstash.com/redis
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ------------------------------------------------------------
# AI — ANTHROPIC
# Get from: https://console.anthropic.com/
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_MODEL=claude-3-5-sonnet-20241022

# Optional: max tokens for AI responses
AI_MAX_TOKENS=4096

# ------------------------------------------------------------
# NOTIFICATIONS — RESEND EMAIL
# Get from: https://resend.com/api-keys
# ------------------------------------------------------------
RESEND_API_KEY=re_your-resend-api-key
ALERT_EMAIL_FROM=noreply@yourdomain.com
ALERT_EMAIL_TO=your@email.com

# ------------------------------------------------------------
# NOTIFICATIONS — SLACK
# Create at: Slack > Apps > Incoming Webhooks
# ------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ------------------------------------------------------------
# DATA CONNECTORS
# Leave empty to use stub/mock fallback for that connector
# ------------------------------------------------------------

# Etsy Open API v3
# Register at: https://www.etsy.com/developers/
ETSY_API_KEY=your-etsy-api-key

# Pinterest API v5
# Register at: https://developers.pinterest.com/
PINTEREST_ACCESS_TOKEN=your-pinterest-access-token

# ------------------------------------------------------------
# APP CONFIGURATION
# ------------------------------------------------------------

# Brand identity (used in AI prompts and reports)
BRAND_NAME=Marka Adı
BRAND_MARKET=Turkey,Europe
BRAND_STYLE_FOCUS=minimalist,gold-plated,silver,gemstone
BRAND_TARGET_CUSTOMER=women 20-40, gift buyers, bridal
BRAND_PRICE_MIN=25
BRAND_PRICE_MAX=250
BRAND_CATEGORIES=rings,necklaces,bracelets,earrings,anklets

# Report language: tr (Turkish) or en (English)
REPORT_LANGUAGE=tr

# Environment: development | production
APP_ENV=production

# API host/port (Railway sets PORT automatically)
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------
# SCHEDULING
# These match Railway Cron job schedules
# ------------------------------------------------------------

# Timezone for scheduled jobs
TZ=Europe/Istanbul

# Enable/disable demo mode (uses mock connector only)
# Set to true if no external API keys are available
DEMO_MODE=false

# ------------------------------------------------------------
# OPTIONAL: LOGGING
# ------------------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=  # optional: Sentry error tracking DSN
